(footprint "ld2410c" (version 20221018) (generator opencad-lib)
  (layer "F.Cu")
  (descr "Hi-Link HLK-LD2410C 24GHz mmWave human presence radar module, 22x16mm, 5-pin 2.54 header (TX RX OUT GND VCC - official datasheet; the 1.27 pitch applies to LD2410/B, not C). Socketed: fit a 1x05 female header and solder pins out the module's back; 3D model is the official Hi-Link STEP offset 8.5 mm for the socket. Keep the antenna face unobstructed.")
  (tags "LD2410C mmWave radar presence sensor module")
  (attr through_hole)
